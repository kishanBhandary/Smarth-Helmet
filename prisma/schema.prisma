// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User role enum
enum Role {
  COMPANY_ADMIN
  COMPANY_EMPLOYEE
}

// Incident severity
enum Severity {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Helmet status
enum HelmetStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

// Dataset status
enum DatasetStatus {
  UPLOADED
  VALIDATING
  PROCESSING
  PROCESSED
  FAILED
}

model Company {
  id              String   @id @default(cuid())
  name            String
  officialEmail   String   @unique
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  invitations     Invitation[]
  datasets        Dataset[]
  riders          Rider[]
  helmets         Helmet[]
  trips           Trip[]
  helmetDataRecords HelmetDataRecord[]
  incidents       Incident[]
  predictions     Prediction[]
  reports         Report[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(COMPANY_EMPLOYEE)
  permissions   String[]  // Array of permissions e.g., ["VIEW_DASHBOARD", "UPLOAD_DATASET"]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // NextAuth Relations
  accounts      Account[]
  sessions      Session[]

  @@index([companyId])
  @@index([email])
}

// Keep standard NextAuth Account and Session models, but make sure they don't block.
model Account {
  id                 String    @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?   @db.Text
  access_token       String?   @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?   @db.Text
  session_state      String?

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        Role     @default(COMPANY_EMPLOYEE)
  permissions String[]
  token       String   @unique
  expires     DateTime
  createdAt   DateTime @default(now())

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([email, companyId])
  @@index([companyId])
}

model Dataset {
  id              String        @id @default(cuid())
  fileName        String
  uploadedBy      String        // User ID or name
  status          DatasetStatus @default(UPLOADED)
  totalRecords    Int           @default(0)
  validRecords    Int           @default(0)
  invalidRecords  Int           @default(0)
  duplicateRecords Int          @default(0)
  errorMessage    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  records         HelmetDataRecord[]

  @@index([companyId])
}

model Rider {
  id           String     @id @default(cuid())
  riderId      String     // External ID from Excel
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  helmetId     String?
  helmet       Helmet?    @relation(fields: [helmetId], references: [id], onDelete: SetNull)
  
  trips        Trip[]
  records      HelmetDataRecord[]
  incidents    Incident[]
  predictions  Prediction[]

  @@unique([companyId, riderId])
  @@index([companyId])
}

model Helmet {
  id           String       @id @default(cuid())
  helmetId     String       // External ID from Excel
  status       HelmetStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  riders       Rider[]
  trips        Trip[]
  records      HelmetDataRecord[]
  incidents    Incident[]

  @@unique([companyId, helmetId])
  @@index([companyId])
}

model Trip {
  id           String     @id @default(cuid())
  tripId       String     // External ID from Excel
  startTime    DateTime
  endTime      DateTime?
  duration     Int?       // In seconds
  distance     Float?     // In km
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  riderId      String
  rider        Rider      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  
  helmetId     String
  helmet       Helmet     @relation(fields: [helmetId], references: [id], onDelete: Cascade)

  records      HelmetDataRecord[]
  incidents    Incident[]

  @@unique([companyId, tripId])
  @@index([companyId])
  @@index([riderId])
  @@index([helmetId])
}

model HelmetDataRecord {
  id             String   @id @default(cuid())
  timestamp      DateTime
  
  speed          Float?
  acceleration   Float?
  braking        String?  // e.g., 'Normal', 'Harsh'
  sharpTurn      Boolean?
  tiltAngle      Float?
  impact         Float?   // Or String depending on sensor value
  
  latitude       Float?
  longitude      Float?
  gpsRaw         String?
  location       String?
  
  weather        String?
  roadCondition  String?
  
  accident       Boolean  @default(false)
  severity       Severity @default(NONE)
  
  createdAt      DateTime @default(now())

  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  datasetId      String?
  dataset        Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  riderId        String
  rider          Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  helmetId       String
  helmet         Helmet   @relation(fields: [helmetId], references: [id], onDelete: Cascade)

  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([datasetId])
  @@index([riderId])
  @@index([helmetId])
  @@index([tripId])
  @@index([timestamp])
  @@index([accident])
  @@index([severity])
}

model Incident {
  id             String   @id @default(cuid())
  timestamp      DateTime
  
  speed          Float?
  acceleration   Float?
  impact         Float?
  
  latitude       Float?
  longitude      Float?
  location       String?
  
  accident       Boolean  @default(false)
  severity       Severity @default(NONE)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  riderId        String
  rider          Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  helmetId       String
  helmet         Helmet   @relation(fields: [helmetId], references: [id], onDelete: Cascade)

  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  prediction     Prediction?

  @@index([companyId])
  @@index([riderId])
  @@index([helmetId])
  @@index([tripId])
  @@index([timestamp])
  @@index([severity])
}

model Prediction {
  id                 String   @id @default(cuid())
  accidentPrediction Boolean?
  severityPrediction Severity?
  riskScore          Float?
  confidence         Float?
  modelVersion       String?
  createdAt          DateTime @default(now())

  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  incidentId         String?  @unique
  incident           Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  riderId            String?
  rider              Rider?   @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([riderId])
}

model Report {
  id             String   @id @default(cuid())
  title          String
  description    String?
  generatedBy    String
  fileUrl        String?
  createdAt      DateTime @default(now())

  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
